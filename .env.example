# Optional Resume Studio paths. Defaults target the local Job_seeker workspace.
RESUME_STUDIO_WORKSPACE_ROOT=/Users/ryand/dev/Job_seeker
RESUME_STUDIO_MASTER_PROFILE=/Users/ryand/dev/Job_seeker/01_profile/career-master.md
RESUME_STUDIO_EVIDENCE_LEDGER=/Users/ryand/dev/Job_seeker/01_profile/evidence-ledger.md
# Required outside development. The server endpoint remains local-origin only.
RESUME_STUDIO_ENABLED=false
VITE_RESUME_STUDIO_ENABLED=false
# Required whenever the tailoring API is enabled. Generate at least 32 random bytes
# (for example: openssl rand -hex 32) and enter it in the Studio password field.
# The client keeps this token in component memory only; it is never persisted.
RESUME_STUDIO_ACCESS_TOKEN=
# Optional server-controlled OpenAI-compatible endpoint; never expose it as VITE_*.
RESUME_STUDIO_OPENAI_ENDPOINT=https://api.openai.com/v1
# Required independent OpenAI-compatible semantic verifier. Do not reuse the
# user-selected drafting model or expose these values through VITE_*.
RESUME_STUDIO_VERIFIER_ENDPOINT=https://api.openai.com/v1/chat/completions
RESUME_STUDIO_VERIFIER_API_KEY=
RESUME_STUDIO_VERIFIER_MODEL=
# Best-effort callback after the CV is safely persisted in Magic Resume.
VITE_JOB_SEEKER_API_URL=http://127.0.0.1:8765
VITE_JOB_SEEKER_INTEGRATION_TOKEN=
JOB_SEEKER_INTEGRATION_TOKEN=
